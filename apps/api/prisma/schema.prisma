generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum TradingMode {
  PAPER
  LIVE
}

enum OrderSide {
  BUY
  SELL
}

enum OrderType {
  MARKET
  LIMIT
}

enum OrderStatus {
  RECEIVED
  VALIDATING
  REJECTED
  READY
  ORDER_REQUESTED
  ORDER_ACCEPTED
  PARTIALLY_FILLED
  FILLED
  CANCELLED
  FAILED
  UNKNOWN
}

enum SignalStatus {
  RECEIVED
  VALIDATING
  REJECTED
  APPROVED
  ORDER_CREATED
  ORDER_FAILED
  COMPLETED
}

enum SystemEventType {
  INFO
  WARN
  ERROR
  CRITICAL
}

model User {
  id             String   @id @default(uuid()) @db.Char(36)
  email          String   @unique @db.VarChar(255)
  passwordHash   String   @db.VarChar(255)
  displayName    String   @db.VarChar(100)
  isActive       Boolean  @default(true)
  lastLoginAt    DateTime? @db.DateTime(3)
  createdAt      DateTime @default(now()) @db.DateTime(3)
  updatedAt      DateTime @updatedAt @db.DateTime(3)

  refreshTokens  RefreshToken[]
}

model RefreshToken {
  id         String   @id @default(uuid()) @db.Char(36)
  tokenHash  String   @db.VarChar(255)
  expiresAt  DateTime @db.DateTime(3)
  revokedAt  DateTime? @db.DateTime(3)
  createdAt  DateTime @default(now()) @db.DateTime(3)

  userId     String   @db.Char(36)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model TradingSystemSetting {
  id              String      @id @default(uuid()) @db.Char(36)
  tradingEnabled  Boolean     @default(false)
  mode            TradingMode @default(PAPER)
  stopReason      String?     @db.VarChar(255)
  webhookSecret   String?     @db.VarChar(255)
  createdAt       DateTime    @default(now()) @db.DateTime(3)
  updatedAt       DateTime    @updatedAt @db.DateTime(3)
}

model Strategy {
  id             String   @id @default(uuid()) @db.Char(36)
  code           String   @unique @db.VarChar(50)
  name           String   @db.VarChar(100)
  description    String?  @db.VarChar(255)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now()) @db.DateTime(3)
  updatedAt      DateTime @updatedAt @db.DateTime(3)

  signals        TradingSignal[]
  orders         Order[]
  allowedSymbols AllowedSymbol[]
}

model AllowedSymbol {
  id          String   @id @default(uuid()) @db.Char(36)
  symbol      String   @db.VarChar(20)
  exchange    String   @db.VarChar(20)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.DateTime(3)
  updatedAt   DateTime @updatedAt @db.DateTime(3)

  strategyId  String   @db.Char(36)
  strategy    Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  @@unique([strategyId, symbol])
  @@index([symbol])
}

model TradingSignal {
  id           String       @id @default(uuid()) @db.Char(36)
  eventId      String       @unique @db.VarChar(100)
  strategyId   String       @db.Char(36)
  symbol       String       @db.VarChar(20)
  exchange     String       @db.VarChar(20)
  side         OrderSide
  orderType    OrderType
  quantity     Decimal      @db.Decimal(18, 6)
  price        Decimal?     @db.Decimal(18, 6)
  status       SignalStatus @default(RECEIVED)
  rawPayload   Json
  receivedAt   DateTime     @default(now()) @db.DateTime(3)
  validatedAt  DateTime?    @db.DateTime(3)
  rejectedAt   DateTime?    @db.DateTime(3)
  createdAt    DateTime     @default(now()) @db.DateTime(3)
  updatedAt    DateTime     @updatedAt @db.DateTime(3)

  strategy     Strategy     @relation(fields: [strategyId], references: [id], onDelete: Restrict)
  order        Order?
  rejection    RiskRejection?

  @@index([strategyId, receivedAt])
  @@index([symbol, receivedAt])
}

model Order {
  id             String      @id @default(uuid()) @db.Char(36)
  clientOrderId   String      @unique @db.VarChar(100)
  brokerOrderId   String?     @unique @db.VarChar(100)
  signalId        String      @unique @db.Char(36)
  strategyId      String      @db.Char(36)
  symbol          String      @db.VarChar(20)
  exchange        String      @db.VarChar(20)
  side            OrderSide
  orderType       OrderType
  requestedQty    Decimal     @db.Decimal(18, 6)
  requestedPrice  Decimal?    @db.Decimal(18, 6)
  filledQty       Decimal     @default(0) @db.Decimal(18, 6)
  averagePrice    Decimal?    @db.Decimal(18, 6)
  status          OrderStatus @default(RECEIVED)
  failReason      String?     @db.VarChar(255)
  createdAt       DateTime    @default(now()) @db.DateTime(3)
  updatedAt       DateTime    @updatedAt @db.DateTime(3)

  signal          TradingSignal @relation(fields: [signalId], references: [id], onDelete: Cascade)
  strategy        Strategy      @relation(fields: [strategyId], references: [id], onDelete: Restrict)
  executions      Execution[]
  statusHistory   OrderStatusHistory[]

  @@index([strategyId, createdAt])
  @@index([symbol, createdAt])
}

model OrderStatusHistory {
  id          String      @id @default(uuid()) @db.Char(36)
  orderId     String      @db.Char(36)
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  reason      String?     @db.VarChar(255)
  createdAt   DateTime    @default(now()) @db.DateTime(3)

  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model Execution {
  id             String   @id @default(uuid()) @db.Char(36)
  orderId        String   @db.Char(36)
  brokerExecId   String?  @unique @db.VarChar(100)
  quantity       Decimal  @db.Decimal(18, 6)
  price          Decimal  @db.Decimal(18, 6)
  executedAt     DateTime @db.DateTime(3)
  createdAt      DateTime @default(now()) @db.DateTime(3)

  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, executedAt])
}

model Position {
  id            String   @id @default(uuid()) @db.Char(36)
  symbol        String   @db.VarChar(20)
  exchange      String   @db.VarChar(20)
  quantity      Decimal  @db.Decimal(18, 6)
  averagePrice  Decimal  @db.Decimal(18, 6)
  lastPrice     Decimal? @db.Decimal(18, 6)
  updatedAt     DateTime @updatedAt @db.DateTime(3)
  createdAt     DateTime @default(now()) @db.DateTime(3)

  @@unique([symbol, exchange])
}

model RiskRejection {
  id          String      @id @default(uuid()) @db.Char(36)
  signalId    String      @unique @db.Char(36)
  code        String      @db.VarChar(50)
  message     String      @db.VarChar(255)
  createdAt   DateTime    @default(now()) @db.DateTime(3)

  signal      TradingSignal @relation(fields: [signalId], references: [id], onDelete: Cascade)
}

model DailyAccountSummary {
  id            String   @id @default(uuid()) @db.Char(36)
  businessDate  DateTime @db.Date
  totalBuyAmt   Decimal  @default(0) @db.Decimal(18, 2)
  totalSellAmt  Decimal  @default(0) @db.Decimal(18, 2)
  realizedPnl   Decimal  @default(0) @db.Decimal(18, 2)
  orderCount    Int      @default(0)
  createdAt     DateTime @default(now()) @db.DateTime(3)
  updatedAt     DateTime @updatedAt @db.DateTime(3)

  @@unique([businessDate])
}

model SystemEvent {
  id          String          @id @default(uuid()) @db.Char(36)
  type        SystemEventType
  eventKey    String?         @db.VarChar(100)
  level       String          @db.VarChar(20)
  message     String          @db.VarChar(500)
  metadata    Json?
  createdAt   DateTime        @default(now()) @db.DateTime(3)

  @@index([type, createdAt])
  @@index([eventKey, createdAt])
}
